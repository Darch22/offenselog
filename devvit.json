{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "offenselog",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "View Violation History",
        "description": "View this user's violation history in this subreddit.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/view-violations"
      },
      {
        "label": "View Violation History",
        "description": "View this user's violation history in this subreddit.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/view-violations"
      },
      {
        "label": "Reset Violation History",
        "description": "Clear the user's violation history in this subreddit.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-violations"
      },
      {
        "label": "Reset Violation History",
        "description": "Clear the user's violation history in this subreddit.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-violations"
      },
      {
        "label": "Lookup User Violations",
        "description": "Look up any user's violation history by username.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/lookup-user"
      }
    ]
  },
  "forms": {
    "violationHistory": "/internal/form/violation-history-submit",
    "resetViolations": "/internal/form/reset-violations-submit",
    "lookupInput": "/internal/form/lookup-input-submit",
    "lookupResult": "/internal/form/lookup-result-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onModAction": "/internal/triggers/on-mod-action"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true
  },
  "dev": {
    "subreddit": "offenselog_dev"
  },
  "settings": {
    "subreddit": {
      "tier1Threshold": {
        "type": "number",
        "label": "Tier 1 threshold (warning)",
        "defaultValue": 3
      },
      "tier2Threshold": {
        "type": "number",
        "label": "Tier 2 threshold (temp ban)",
        "defaultValue": 5
      },
      "tier3Threshold": {
        "type": "number",
        "label": "Tier 3 threshold (perma ban)",
        "defaultValue": 8
      },
      "decayWindowDays": {
        "type": "number",
        "label": "Violation decay window (days)",
        "defaultValue": 30
      },
      "tier2BanDuration": {
        "type": "number",
        "label": "Tier 2 temp ban duration (days)",
        "defaultValue": 14
      },
      "warningMessage": {
        "type": "string",
        "label": "Warning DM message",
        "defaultValue": "You have received multiple content removals. Please review the community rules."
      },
      "banMessage": {
        "type": "string",
        "label": "Ban message",
        "defaultValue": "You have been banned due to rule violations."
      }
    }
  },
  "scheduler": {
    "tasks": {
      "decay-cleanup-task": {
        "endpoint": "/internal/scheduler/decay-cleanup-task",
        "cron": "0 4 * * *"
      }
    }
  }
}